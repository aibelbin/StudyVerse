{
  "name": "virtual-study-world",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "INVITE_CODE=${INVITE_CODE:-cozy} tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "train:pets": "tsx pets/train.ts"
  },
  "dependencies": {
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
